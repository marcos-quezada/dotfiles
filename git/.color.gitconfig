# terminal-agnostic color config — works on both light (foot/gameboy) and dark (VT) backgrounds
# was attribute-only (bold/reverse/dim/italic, no named colors) everywhere at first, on the
# reasoning that reverse swaps fg↔bg regardless of palette (dark block on light bg, light block
# on dark bg) and bold increases weight on both. Revised after a real, screenshot-driven review:
# bold-only differentiation is too weak once two things need telling apart (e.g. diff added vs.
# context lines rendered nearly identically). foot's gameboy palette (foot.ini) only has ONE
# genuinely distinct hue available at all — the "red" ANSI slot, deliberately set to a warm
# brown (8b530f) specifically for this — every other slot (green/blue/magenta/cyan) maps to the
# same medium-dark green (306230), and yellow is barely distinguishable from the background.
# So: brightred is now used deliberately, exactly once per concern, wherever attributes alone
# weren't enough — never as a general-purpose accent, since there's only the one real option.
# Confirmed via real screenshots on both terminals: plain "red" + bold rendered unreadably dark
# on VT (VT apparently doesn't brighten bold-attributed colors the way some terminals do), so
# brightred is used explicitly rather than relying on bold to reach the bright variant. foot's
# own bright1/regular1 are identical (8b530f) in this custom palette, so this is a safe no-op
# there.

[color]
    ui = true

[color "grep"]
    match = bold reverse

[color "status"]
    # dim header so the file list pops relative to it
    header = dim
    # added: bold — heavier weight against the light background, clearly readable
    added = bold
    # changed/modified: reverse block — dark rectangle, maximum contrast, impossible to miss
    changed = reverse
    # untracked: plain foreground — readable, lower urgency than added/changed
    untracked = normal
    # branch name in header: bold so it stands out from surrounding dim text
    branch = bold
    # detached head: bold reverse blink — alarming on any palette
    nobranch = bold reverse blink
    # hint: reverse — default cyan (slot 6 = 8bac0f on gameboy) is near-invisible
    # against the 9bbc0f background (~3% luminance delta). reverse gives 9bbc0f text
    # on 0f380f block — maximum contrast on gameboy. on VT the dark background makes
    # reverse a light-on-dark block, equally readable. attribute-only: palette-independent.
    hint = reverse

[color "diff"]
    # meta and frag lines recede — they frame the diff, not the content
    meta = dim
    frag = dim
    # context lines: plain, no decoration
    context = normal
    # removed: brightred (the one reserved accent) + bold reverse — a brown block,
    # unmistakably different from every other block in the diff, not just heavier
    old = brightred bold reverse
    # added: bold reverse, no color — same visual weight/treatment as removed (a block, not
    # just bold text), differentiated from it by hue (green-toned block vs. brown block)
    # rather than by weight alone. confirmed via screenshot: bold-only was too close to
    # context lines to tell apart at a glance
    new = bold reverse
    # function/hunk header: italic to distinguish from content
    func = italic

[color "commit"]
    # the commit hash itself: brightred bold. git's own default (yellow) is a shade very close
    # to the gameboy background (8bac0f vs 9bbc0f, near-invisible) — confirmed unreadable
    # via screenshot on "lol"/"ll" (bare --decorate/--oneline, no custom format, so they
    # inherit this default rather than lool's own hardcoded %C tokens)
    commit = brightred bold

[color "decorate"]
    # ref names shown by --decorate. attribute-only is enough here — these aren't competing
    # with diff content for attention the way added/removed lines are
    HEAD = bold
    branch = bold
    remoteBranch = dim
    tag = italic
