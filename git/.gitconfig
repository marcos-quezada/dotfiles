[user]
	email = quezad@gmail.com
	name = Marcos Quezada-Perez

[color]
  ui = auto

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  rename = true

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[help]
  autocorrect = prompt

[commit]
  verbose = true

[pull]
  rebase = true

[core]
	autocrlf = input
	excludesFile = ~/.gitignore

[init]
	defaultBranch = main

[alias]
  lool = log --graph --color=always --date=short --pretty=tformat:"%C(red)%h%C(reset)%x20%s%C(bold)%d%C(reset)%x20[%an]"
	lol = log --graph --date=short --all --pretty=format:"%C(red)%h%C(reset)%x20%s%C(bold)%d%C(reset)%x20[%an]" -1
  ll = log --graph --date=short --all --pretty=format:"%C(red)%h%C(reset)%x20%s%C(bold)%d%C(reset)%x20[%an]" -10
  cfw = "!git-clone-bare-for-worktrees"

[include]
  path = ~/.color.gitconfig
