#!/bin/sh
# ---------------------------------------------------------------------------
# queue-track - append a YouTube URL to the quickshell playlist inbox (invoked via the quickshell-add: URI scheme)
#
# Copyright 2026, Marcos Quezada Pérez <mquezada@auryn>
# All rights reserved.
#
# Usage: queue-track [-h|--help]
#
# Revision history:
# 2026-09-11  Created by new_script ver. 3.3-posix
# ---------------------------------------------------------------------------

PROGNAME="${0##*/}"
VERSION="0.1"

clean_up() { # perform pre-exit housekeeping
    return
}

error_exit() {
    printf '%s: %s\n' "$PROGNAME" "${1:-unknown error}" >&2
    clean_up
    exit 1
}

graceful_exit() {
    clean_up
    exit 0
}

# shellcheck disable=SC2329  # called via trap string, not directly
signal_exit() { # handle trapped signals
    case "$1" in
        INT)  error_exit "program interrupted by user" ;;
        TERM) printf '\n%s: program terminated\n' "$PROGNAME" >&2; graceful_exit ;;
        *)    error_exit "terminating on unknown signal" ;;
    esac
}

usage() {
    printf '%s\n' "queue-track [-h|--help] <url>"
}

help_message() {
    cat <<- _EOF_
	$PROGNAME ver. $VERSION
	append a YouTube URL to the quickshell playlist inbox (invoked via the quickshell-add: URI scheme)

	$(usage)

	Options:

	  -h, --help  Display this help message and exit.

	appends <url> to \$XDG_DATA_HOME/quickshell/playlist-inbox.txt (default
	~/.local/share/quickshell/playlist-inbox.txt), one line per call. quickshell's
	Services/Playlist.qml watches that file and processes new lines from there.
	<url> may also be a full 'quickshell-add:<percent-encoded-url>' URI, as
	passed by the quickshell-add.desktop scheme handler - the prefix is
	stripped and the remainder percent-decoded automatically.
	_EOF_
}

# trap signals
trap "signal_exit TERM" TERM HUP
trap "signal_exit INT"  INT



# parse command-line
url=""
while [ -n "${1:-}" ]; do
    case "$1" in
        -h | --help) help_message; graceful_exit ;;
        -*)
            usage
            error_exit "unknown option $1" ;;
        *)
            url="$1"
            ;;
    esac
    shift
done

# main logic

[ -n "$url" ] || { usage; error_exit "no URL given"; }

# unwrap the quickshell-add: URI scheme, if that's what we were handed
# (a browser invoking the .desktop handler passes the whole URI, not just
# the percent-encoded URL inside it)
case "$url" in
    quickshell-add:*)
        url="${url#quickshell-add:}"
        # percent-decode: %XX -> \xXX, then let printf interpret the escapes
        url=$(printf '%s' "$url" | sed 's/+/ /g; s/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')
        url=$(printf '%b' "$url")
        ;;
esac

case "$url" in
    http://*|https://*) ;;
    *) error_exit "'$url' doesn't look like a URL" ;;
esac

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/quickshell"
inbox_file="$data_dir/playlist-inbox.txt"

mkdir -p "$data_dir" || error_exit "could not create $data_dir"
printf '%s\n' "$url" >> "$inbox_file" || error_exit "could not write to $inbox_file"

graceful_exit
