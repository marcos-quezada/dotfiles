#!/bin/sh
# ---------------------------------------------------------------------------
# hardpass-net - Bring up/tear down the HardPass (Pi Zero W2 RNDIS gadget) network link on attach/dettach, triggered by devd
#
# Copyright 2026, Marcos Quezada Pérez <mquezada@auryn>
# All rights reserved.
#
# Usage: hardpass-net [-h|--help]
#
# Revision history:
# 2026-10-01  Created by new_script ver. 3.3-posix
# ---------------------------------------------------------------------------

PROGNAME="${0##*/}"
VERSION="0.1"

clean_up() { # perform pre-exit housekeeping
    return
}

error_exit() {
    printf '%s: %s\n' "$PROGNAME" "${1:-unknown error}" >&2
    clean_up
    exit 1
}

graceful_exit() {
    clean_up
    exit 0
}

# shellcheck disable=SC2329  # called via trap string, not directly
signal_exit() { # handle trapped signals
    case "$1" in
        INT)  error_exit "program interrupted by user" ;;
        TERM) printf '\n%s: program terminated\n' "$PROGNAME" >&2; graceful_exit ;;
        *)    error_exit "terminating on unknown signal" ;;
    esac
}

usage() {
    printf '%s\n' "hardpass-net [-h|--help]"
}

help_message() {
    cat <<- _EOF_
	$PROGNAME ver. $VERSION
	Bring up/tear down the HardPass (Pi Zero W2 RNDIS gadget) network link on attach/dettach, triggered by devd

	$(usage)

	Options:

	  -h, --help  Display this help message and exit.

	NOTE: You must be the superuser to run this script.

	_EOF_
}

# trap signals
trap "signal_exit TERM" TERM HUP
trap "signal_exit INT"  INT

# check for root UID
if [ "$(id -u)" != "0" ]; then
    error_exit "you must be the superuser to run this script"
fi

# parse command-line
while [ -n "${1:-}" ]; do
    case "$1" in
        -h | --help) help_message; graceful_exit ;;
        -*)
            usage
            error_exit "unknown option $1" ;;
        *)
            action="$1"
            ;;
    esac
    shift
done

case "$action" in
  attach|detach) ;;
  *) usage; error_exit "expected 'attach' or 'detach', got '${action:-nothing}'" ;;
esac

IFACE="ue0"
PI_ADDR="10.18.1.19"

case "$action" in
  attach)
    ifconfig "$IFACE" up
    sleep 2
    dhclient "$IFACE" || error_exit "dhclient failed on $IFACE"
    # dhclient invoked this way skips its normal resolvconf hook --
    # feed it manually
    echo "nameserver $PI_ADDR" | resolvconf -a "$IFACE"
    logger -t "$PROGNAME" "$IFACE attached, resolvconf fed $PI_ADDR"
    ;;
  detach)
    resolvconf -d "$IFACE"
    logger -t "$PROGNAME" "$IFACE detached, resolvconf entry removed"
    ;;
esac

graceful_exit
