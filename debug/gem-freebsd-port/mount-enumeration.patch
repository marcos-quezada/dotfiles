+#if defined(__FreeBSD__)
+/*
+ * FreeBSD has no /proc/mounts or mntent.h; getfsstat(2) returns the whole
+ * mount table in one call instead of a streaming iterator, so we snapshot
+ * it once per gem_os_mount_iter_open()/gem_os_mount_for_path() call and
+ * walk the snapshot. Mirrors the Linux mntent-based behavior seen by
+ * callers: same iterator shape, same "one absolute path per read" contract.
+ */
+struct gem_os_mount_scan {
+    struct statfs *entries;
+    int count;
+    int index;
+};
+
+static struct gem_os_mount_scan *gem_os_mount_scan_create(void)
+{
+    struct gem_os_mount_scan *scan;
+    int count;
+
+    count = getfsstat(NULL, 0, MNT_NOWAIT);
+    if (count < 0) {
+        return NULL;
+    }
+
+    scan = malloc(sizeof(*scan));
+    if (scan == NULL) {
+        return NULL;
+    }
+
+    scan->entries = calloc((size_t)count, sizeof(struct statfs));
+    if (scan->entries == NULL) {
+        free(scan);
+        return NULL;
+    }
+
+    count = getfsstat(scan->entries,
+                       (long)((size_t)count * sizeof(struct statfs)),
+                       MNT_NOWAIT);
+    if (count < 0) {
+        free(scan->entries);
+        free(scan);
+        return NULL;
+    }
+
+    scan->count = count;
+    scan->index = 0;
+    return scan;
+}
+
+static void gem_os_mount_scan_destroy(struct gem_os_mount_scan *scan)
+{
+    if (scan == NULL) {
+        return;
+    }
+    free(scan->entries);
+    free(scan);
+}
+#endif
+
